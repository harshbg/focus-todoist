// Cloudflare Workers static hosting for this fork: the build is a static site
// in dist/ (see docs/deploying.md). Build with PUBLIC_URL set to the site's
// address so "Continue with Todoist" names this domain.
{
  "name": "focus-todoist",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
